# ──────────────────────────────────────────────
# RISU (ローカル版) 環境変数
# ──────────────────────────────────────────────
# このファイルを .env にコピーして実値を記入してください．
# .env はコミット対象外です（.gitignore で除外済）．

# ── LLM バックエンド ──
LLM_BACKEND=claude                # claude / ollama / mock
ANTHROPIC_API_KEY=sk-ant-...      # Claude バックエンドの場合必須
# OLLAMA_BASE_URL=http://localhost:11434   # ollama バックエンドの接続先
# OLLAMA_MODEL=qwen2.5:3b                  # ollama バックエンドのモデル名
# RISU_MAX_HISTORY_CHARS=24000      # LLM に送る会話履歴の文字数予算（0 で無制限）
# RISU_CACHE_TTL=5m                 # Prompt Caching の TTL（5m / 1h）

# ── 待ち受け（任意・省略可） ──
# 既定は 127.0.0.1（このマシンからのみ接続可）．
# RISU は認証を持たないため，0.0.0.0 にすると同一ネットワークの誰でも
# シミュレーション実行・結果閲覧・LLM 呼び出し（= API キーの課金）ができます．
# RISU_HOST=127.0.0.1
# RISU_PORT=8001
# RISU_ALLOWED_ORIGINS=http://localhost:8001,http://127.0.0.1:8001   # CORS の許可オリジン
# RISU_RELOAD=0                     # 開発用オートリロード（1 で有効）

# ── リソース上限（任意・省略可） ──
# RISU_MAX_NODES=50000
# RISU_MAX_LINKS=100000
# RISU_MAX_DEMANDS=10000
# RISU_MAX_TMAX=86400               # 24 時間
# RISU_UXSIM_TIMEOUT=120            # シミュレーション最大実行時間（秒）
# RISU_MAX_TOOL_ROUNDS=3            # LLM tool_use ループ最大回数
# RISU_MAX_UPLOAD_BYTES=10485760    # アップロード上限（10MB）
# RISU_MAX_RESULTS=30               # メモリに保持する結果の件数

# ── 可視化・転送（任意・省略可） ──
# RISU_MAX_FRAMES=200               # 可視化フレーム数の上限（時刻方向の間引き）
# RISU_MAX_FRAME_POINTS=3000000     # 描画用の総点数の上限（超えると車両をサンプリング．0 で無効）
# RISU_RESULTS_ZSTD_LEVEL=3         # /results の zstd 圧縮レベル
# RISU_RESULTS_GZIP_LEVEL=1         # /results の gzip 圧縮レベル（zstd 非対応クライアント向け）
# RISU_OSM_CACHE_DIR=./cache        # OSM 取得結果のキャッシュ先

# ── 結果の永続化（任意・省略可） ──
# 設定すると結果を <sim_id>.json.zst として保存し，再起動後も sim_id で開ける．
# RISU_RESULTS_DIR=./results

# ── ログ・診断（任意・省略可） ──
# RISU_LOG_LEVEL=INFO               # DEBUG で詳細
# RISU_STARTUP_SELFCHECK=1          # 起動時の uxsim 自己診断（0 で無効）
